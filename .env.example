# =============================================================================
# Behold.so feed for the @lolmeetupkorea Instagram pull.
# Paste either form Behold gives you:
#   - Full feed URL:  https://feeds.behold.so/abc123def456
#   - Just the ID:    abc123def456
# Setup:
#   1. Sign up at https://behold.so (free tier)
#   2. Connect the @lolmeetupkorea Instagram account via Meta OAuth
#   3. Create a feed, copy its URL/ID, paste below (no quotes)
# Falls back to placeholders if unset. Revalidates hourly.
# =============================================================================
BEHOLD_FEED_ID=

# =============================================================================
# Discord bot token — used to fetch the server's Scheduled Events for the
# landing-page event calendar. The bot only needs to be a member of the
# guild; no special permissions required for public (GUILD_ONLY) events.
#
# Setup (one-time, ~3 min):
#   1. https://discord.com/developers/applications → New Application
#      → name it (e.g. "LoLMK Site")
#   2. Bot tab → Reset Token → copy the token (paste below).
#   3. OAuth2 → URL Generator
#        scopes: bot
#        bot permissions: (none required; View Channel is fine)
#      Open the generated URL, select the LoLMK guild, authorize.
#   4. Paste the token below. Restart dev server.
#
# When unset, the calendar falls back to src/data/events.json. Revalidates
# every 10 min.
# =============================================================================
DISCORD_BOT_TOKEN=

# Optional: override the Discord invite code used for live stats + guild
# discovery. Defaults to "lolmk" (the discord.gg/lolmk invite).
# DISCORD_INVITE_CODE=lolmk

# =============================================================================
# Admin tools login — Discord OAuth (/tools/*)
# Replaces the old shared ID+password wall. Signing in requires a real
# Discord account that is a member of the LoLMK guild AND holds the
# Tournament Admin role. No bot token needed — this uses the signed-in
# user's own OAuth token (identify + guilds.members.read scopes) to check
# their own guild membership/roles, not a bot-side lookup.
#
# Setup (~3 min):
#   1. https://discord.com/developers/applications -> New Application
#      -> name it (e.g. "LoLMK Admin")
#   2. OAuth2 tab -> copy Client ID, generate + copy Client Secret
#   3. OAuth2 -> Redirects -> add exactly:
#        http://localhost:3001/api/auth/discord/callback
#        https://lolmk.gg/api/auth/discord/callback
#      Save Changes.
#   4. Paste the Client ID/Secret below. Restart the dev server.
#
# Sessions are opaque, random, DB-backed tokens (not signed cookies) — a
# leaked/revoked role or guild kick takes effect on the next re-check
# instead of lingering for a long-lived signed cookie's full lifetime.
#
# SESSION_ENCRYPTION_KEY encrypts the Discord access/refresh tokens stored
# in Postgres (AES-256-GCM). Separate from DISCORD_CLIENT_SECRET so rotating
# one doesn't force rotating the other. Generate with:
#   openssl rand -hex 32
# Production must use its own key, generated independently — never reuse
# a key from local dev or from this file.
#
# SITE_URL is the trusted origin used to build the OAuth redirect_uri
# (deliberately NOT derived from the request's Host header, which is
# spoofable). Production auth remains disabled unless this is an explicit
# HTTPS origin such as https://lolmk.gg. Local development may leave it blank
# to use http://localhost:3001. NEXT_PUBLIC_SITE_URL is accepted only as a
# local-development compatibility fallback; prefer the server-only SITE_URL.
#
# Auth also remains disabled unless SESSION_ENCRYPTION_KEY is exactly 64 hex
# characters (32 bytes), including in local development.
# =============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
SESSION_ENCRYPTION_KEY=
SITE_URL=

# =============================================================================
# Verified-member login (/members/profile) — a THIRD Discord OAuth boundary,
# separate from the admin gate above and from CAPTAIN_ROLE_ID below. See
# src/lib/discord-auth.ts's "Verified-member authentication" section.
#
# TODAY: reuses DISCORD_CLIENT_ID/SECRET/GUILD_ID from the admin block above.
# Login succeeds for any account holding the Tournament Admin role
# (DISCORD_ADMIN_ROLE_ID) — this is admin-only by construction right now.
#
# DISCORD_VERIFIED_ROLE_ID (blank by default): once set, any Discord account
# holding THIS role may also sign in and get a profile — this is the entire
# migration needed to open member login to every verified regular member.
# Nothing else about the flow changes.
#
# DISCORD_COORDINATOR_ROLE_ID (blank by default): purely a directory LABEL.
# An account holding this role is classified "Game Coordinator" on the
# public /members directory instead of "Admin" — it grants no login
# capability of its own and is irrelevant if DISCORD_VERIFIED_ROLE_ID is
# also unset (an account still needs the admin OR verified role to sign in
# at all).
#
# Add this callback to the same Discord app's OAuth2 -> Redirects list:
#   http://localhost:3001/api/auth/member/callback
#   https://lolmk.gg/api/auth/member/callback
# =============================================================================
DISCORD_VERIFIED_ROLE_ID=
DISCORD_COORDINATOR_ROLE_ID=

# =============================================================================
# ARAM Mayhem tool (/tools/mayhem + public /mayhemlive venue screen)
# Needs a Postgres database for shared state across devices (admin laptop +
# venue screen are different browsers/devices, so localStorage won't work).
#
# Setup:
#   1. Vercel dashboard -> your project -> Storage tab -> Create Database -> Postgres
#   2. Click "Connect Project" to this project (auto-injects POSTGRES_* vars
#      into Production + Preview on Vercel).
#   3. Locally: run `vercel env pull .env.local` from the project root to
#      sync the same vars down for local dev.
#
# @vercel/postgres reads POSTGRES_URL automatically — no extra config needed
# once connected. Tables are created automatically on first use.
# =============================================================================
# POSTGRES_URL=

# =============================================================================
# Team logo uploads — Vercel Blob (/tools/summoners-rift + /captain)
# Logos are uploaded through the site, normalised to a square WebP with sharp,
# and stored on Vercel Blob. The returned permanent blob URL is what lands in
# sr_teams.logo_url — a raw Discord CDN URL is never persisted (those expire
# and leak the uploader's CDN path).
#
# Setup:
#   1. Vercel dashboard -> your project -> Storage tab -> Create Database
#      -> Blob -> connect it to this project.
#   2. Locally: `vercel env pull .env.local` to sync the token down.
#
# When unset, the upload control renders DISABLED with a clear message
# instead of crashing — every other part of team management still works.
# =============================================================================
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# Captain self-service (/captain)
# A SEPARATE auth boundary from the admin gate above. Captains sign in with
# their own Discord account and may only ever touch their own team, scoped by
# sr_teams.captain_discord_id. Holding this role grants NO admin access, and
# isCaptainSession() deliberately does not reuse or weaken isToolsSession().
#
# Reuses DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET / DISCORD_GUILD_ID from the
# admin block, plus this role id. Add the captain callback to the same OAuth2
# -> Redirects list:
#   http://localhost:3001/api/auth/captain/callback
#   https://lolmk.gg/api/auth/captain/callback
#
# FAILS CLOSED: while this is blank, every captain route and server action is
# denied. There is no default-allow and no "unconfigured so skip the check"
# bypass — leaving it unset disables captain self-service entirely.
# =============================================================================
CAPTAIN_ROLE_ID=

# =============================================================================
# Riot API — optional rank lookup for rosters (KR region)
# Roster ranks are MANUALLY ENTERED and self-reported by default, and are
# labelled unverified in the UI. With a key set, captains get an optional
# "look up" button that corroborates a summoner's current rank via
# account-v1 + league-v4.
#
# Get a key at https://developer.riotgames.com. A development key expires
# every 24h; a production key needs an approved app.
#
# When unset the lookup button is hidden and the helper returns a clear
# "not configured" result — nothing crashes, manual entry is unaffected.
#
# IMPORTANT: a successful lookup proves a SUMMONER's rank. It is never proof
# that the Discord account that typed the IGN owns that summoner. Riot RSO
# account linking is deliberately not implemented.
# =============================================================================
RIOT_API_KEY=
