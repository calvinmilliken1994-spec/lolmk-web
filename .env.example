# =============================================================================
# Behold.so feed for the @lolmeetupkorea Instagram pull.
# Paste either form Behold gives you:
#   - Full feed URL:  https://feeds.behold.so/abc123def456
#   - Just the ID:    abc123def456
# Setup:
#   1. Sign up at https://behold.so (free tier)
#   2. Connect the @lolmeetupkorea Instagram account via Meta OAuth
#   3. Create a feed, copy its URL/ID, paste below (no quotes)
# Falls back to placeholders if unset. Revalidates hourly.
# =============================================================================
BEHOLD_FEED_ID=

# =============================================================================
# Discord bot token — used to fetch the server's Scheduled Events for the
# landing-page event calendar. The bot only needs to be a member of the
# guild; no special permissions required for public (GUILD_ONLY) events.
#
# Setup (one-time, ~3 min):
#   1. https://discord.com/developers/applications → New Application
#      → name it (e.g. "LoLMK Site")
#   2. Bot tab → Reset Token → copy the token (paste below).
#   3. OAuth2 → URL Generator
#        scopes: bot
#        bot permissions: (none required; View Channel is fine)
#      Open the generated URL, select the LoLMK guild, authorize.
#   4. Paste the token below. Restart dev server.
#
# When unset, the calendar falls back to src/data/events.json. Revalidates
# every 10 min.
# =============================================================================
DISCORD_BOT_TOKEN=

# Optional: override the Discord invite code used for live stats + guild
# discovery. Defaults to "lolmk" (the discord.gg/lolmk invite).
# DISCORD_INVITE_CODE=lolmk
